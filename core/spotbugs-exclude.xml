<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs findings accepted as false positives, one <Match> per finding with
     a comment saying why (ADR 0011). -->
<FindBugsFilter
  xmlns="https://github.com/spotbugs/filter/3.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
  <!-- JsonColumnConverter keeps the JsonMapper bean Spring injects, which is meant to
       be shared; storing it is not exposing internal state. -->
  <Match>
    <Class name="com.crowded.core.shared.infrastructure.persistence.JsonColumnConverter"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- EventCodes keeps the EventRepository port it checks codes with; the port is a
       shared adapter, not state of its own. -->
  <Match>
    <Class name="com.crowded.core.event.domain.service.EventCodes"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- AccessCodeConnections keeps the event and connection ports it connects participants
       with; the ports are shared adapters, not state of its own. -->
  <Match>
    <Class name="com.crowded.core.connection.domain.service.AccessCodeConnections"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- TicketConnections keeps the event, connection, ticket, cipher and hasher ports it connects
       a ticket's owner with; the ports are shared adapters, not state of its own. -->
  <Match>
    <Class name="com.crowded.core.ticket.domain.service.TicketConnections"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- ConnectedTicket hands the event and connection a participant just got back to the use
       case in the same request; they are read there and never changed. -->
  <Match>
    <Class name="com.crowded.core.ticket.domain.model.ConnectedTicket"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- JoinedConnection hands the event a participant just connected to back to the use case
       in the same request; it is read there and never changed. -->
  <Match>
    <Class name="com.crowded.core.connection.domain.model.JoinedConnection"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- ManagedEvent hands the aggregate the use case just saved to the API mapper in the
       same request; it is read there and never changed. -->
  <Match>
    <Class name="com.crowded.core.event.application.dto.ManagedEvent"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
