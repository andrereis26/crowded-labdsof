<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_workflow_2_official_change_notification" targetNamespace="https://crowded.example/bpmn" exporter="crowded-labdsof" exporterVersion="1.0">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool_ipma" name="IPMA (public weather warnings)" />
    <bpmn:participant id="Pool_crowded" name="Crowded" processRef="Proc_Pool_crowded" />
    <bpmn:participant id="Pool_part" name="Participant" processRef="Proc_Pool_part" />
    <bpmn:messageFlow id="Msg_1" name="warnings (JSON)" sourceRef="Pool_ipma" targetRef="fetch" />
    <bpmn:messageFlow id="Msg_2" sourceRef="notify" targetRef="rcv" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Pool_crowded" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Pool_crowded">
      <bpmn:lane id="Lane_O" name="Organization (backoffice)">
        <bpmn:flowNodeRef>so</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orgpub</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_J" name="Weather (Jobs)">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>keep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_K" name="Core">
        <bpmn:flowNodeRef>rec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_N" name="Notifications">
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="so" name="Change decided (e.g. a stage moves)">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="orgpub" name="Publish the change: new date, time or venue, ticket validity, refund info">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="s" name="Every 5 minutes">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="s_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="fetch" name="Fetch IPMA warnings for the districts of upcoming events">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="IPMA available and data valid?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="keep" name="Keep the last data with its time, log, retry">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Retry on next run">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g2" name="New or raised orange or red warning?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e2" name="Stored, no notification">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="rec" name="Record the change or warning with source and severity; request notification">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="g3" name="Already notified for this cause?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e3" name="Ignore duplicate">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="notify" name="Notify connected participants (per preferences), labelled with source">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e4" name="Notified">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="fetch" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="fetch" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_3" name="Yes" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_4" name="No" sourceRef="g1" targetRef="keep" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="keep" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_6" name="No" sourceRef="g2" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="g2" targetRef="rec" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="so" targetRef="orgpub" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="orgpub" targetRef="rec" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="rec" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="g3" targetRef="e3" />
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="g3" targetRef="notify" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="notify" targetRef="e4" />
  </bpmn:process>
  <bpmn:process id="Proc_Pool_part" isExecutable="false">
    <bpmn:startEvent id="rcv" name="Notification received">
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="rcv_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="open" name="Open the event: what changes for me">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e5" name="Informed">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="rcv" targetRef="open" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="open" targetRef="e5" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Pool_ipma_di" bpmnElement="Pool_ipma" isHorizontal="true"><dc:Bounds x="16" y="16" width="1360" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_crowded_di" bpmnElement="Pool_crowded" isHorizontal="true"><dc:Bounds x="16" y="96" width="1360" height="604" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_O_di" bpmnElement="Lane_O" isHorizontal="true"><dc:Bounds x="46" y="96" width="1330" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_J_di" bpmnElement="Lane_J" isHorizontal="true"><dc:Bounds x="46" y="196" width="1330" height="234" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_K_di" bpmnElement="Lane_K" isHorizontal="true"><dc:Bounds x="46" y="430" width="1330" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_N_di" bpmnElement="Lane_N" isHorizontal="true"><dc:Bounds x="46" y="530" width="1330" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_part_di" bpmnElement="Pool_part" isHorizontal="true"><dc:Bounds x="16" y="720" width="1360" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="so_di" bpmnElement="so"><dc:Bounds x="340" y="130" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="291" y="167" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="orgpub_di" bpmnElement="orgpub"><dc:Bounds x="410" y="106" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="110" y="230" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="61" y="267" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fetch_di" bpmnElement="fetch"><dc:Bounds x="180" y="206" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="350" y="225" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="306" y="272" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="keep_di" bpmnElement="keep"><dc:Bounds x="330" y="340" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="490" y="364" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="441" y="401" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="600" y="225" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="556" y="272" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="605" y="364" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="556" y="401" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rec_di" bpmnElement="rec"><dc:Bounds x="760" y="440" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g3_di" bpmnElement="g3" isMarkerVisible="true"><dc:Bounds x="930" y="559" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="886" y="514" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e3_di" bpmnElement="e3"><dc:Bounds x="935" y="639" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="886" y="676" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify_di" bpmnElement="notify"><dc:Bounds x="1020" y="540" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e4_di" bpmnElement="e4"><dc:Bounds x="1190" y="564" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="1141" y="601" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rcv_di" bpmnElement="rcv"><dc:Bounds x="1067" y="754" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="1018" y="791" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="open_di" bpmnElement="open"><dc:Bounds x="1140" y="730" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e5_di" bpmnElement="e5"><dc:Bounds x="1300" y="754" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="1251" y="791" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="142" y="246" /><di:waypoint x="180" y="246" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="306" y="246" /><di:waypoint x="350" y="246" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="392" y="246" /><di:waypoint x="600" y="246" /><bpmndi:BPMNLabel><dc:Bounds x="398" y="228" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="371" y="267" /><di:waypoint x="371" y="340" /><bpmndi:BPMNLabel><dc:Bounds x="377" y="314" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="456" y="380" /><di:waypoint x="490" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="621" y="267" /><di:waypoint x="621" y="364" /><bpmndi:BPMNLabel><dc:Bounds x="627" y="314" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="642" y="246" /><di:waypoint x="720" y="246" /><di:waypoint x="720" y="480" /><di:waypoint x="760" y="480" /><bpmndi:BPMNLabel><dc:Bounds x="648" y="228" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="372" y="146" /><di:waypoint x="410" y="146" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="536" y="146" /><di:waypoint x="823" y="146" /><di:waypoint x="823" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="823" y="520" /><di:waypoint x="823" y="580" /><di:waypoint x="930" y="580" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="951" y="601" /><di:waypoint x="951" y="639" /><bpmndi:BPMNLabel><dc:Bounds x="957" y="612" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="972" y="580" /><di:waypoint x="1020" y="580" /><bpmndi:BPMNLabel><dc:Bounds x="978" y="562" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1146" y="580" /><di:waypoint x="1190" y="580" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18"><di:waypoint x="1099" y="770" /><di:waypoint x="1140" y="770" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19_di" bpmnElement="Flow_19"><di:waypoint x="1266" y="770" /><di:waypoint x="1300" y="770" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Msg_1_di" bpmnElement="Msg_1"><di:waypoint x="243" y="76" /><di:waypoint x="243" y="206" /><bpmndi:BPMNLabel><dc:Bounds x="250" y="110" width="105" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Msg_2_di" bpmnElement="Msg_2"><di:waypoint x="1083" y="620" /><di:waypoint x="1083" y="754" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
