<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_workflow_2_official_change_notification" targetNamespace="https://crowded.example/bpmn" exporter="crowded-labdsof" exporterVersion="1.0">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool_src" name="Ticketing source (simulator)" />
    <bpmn:participant id="Pool_crowded" name="Crowded" processRef="Proc_crowded" />
    <bpmn:participant id="Pool_part" name="Participant" processRef="Proc_part" />
    <bpmn:messageFlow id="Msg_1" name="event data" sourceRef="Pool_src" targetRef="fetch" />
    <bpmn:messageFlow id="Msg_2" sourceRef="notify" targetRef="rcv" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_crowded" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proc_crowded">
      <bpmn:lane id="Lane_O" name="Organization">
        <bpmn:flowNodeRef>so</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>orgpub</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_S" name="Event Sync (Jobs)">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>keep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_K" name="Core">
        <bpmn:flowNodeRef>match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_N" name="Notifications">
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="so" name="Change decided (e.g. artist ill)">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="orgpub" name="Publish change: new date, ticket validity, refund info">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="s" name="Periodic sync">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="s_timer" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="fetch" name="Fetch event data from source">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Source available and data valid?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="keep" name="Keep last data, show last update, log and retry">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Retry on next sync">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g2" name="Change detected? (cancel, date, venue)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e2" name="No action">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="match" name="Match change to the event and its recorded changes">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gM" name="Same change already recorded from the other source?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="corr" name="Add as corroborating source; flag if values differ">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="eR" name="Recorded once, no new notification">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="rec" name="Record change with source and severity; publish EventChanged">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="g3" name="Already notified for this change?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e3" name="Ignore duplicate">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="notify" name="Notify holders and followers (per preferences), labelled with source">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e4" name="Notified">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="fetch" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="fetch" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_3" name="Yes" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_4" name="No" sourceRef="g1" targetRef="keep" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="keep" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_6" name="Yes" sourceRef="g2" targetRef="match" />
    <bpmn:sequenceFlow id="Flow_7" name="No" sourceRef="g2" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="so" targetRef="orgpub" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="orgpub" targetRef="match" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="match" targetRef="gM" />
    <bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="gM" targetRef="corr" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="corr" targetRef="eR" />
    <bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="gM" targetRef="rec" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="rec" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="g3" targetRef="notify" />
    <bpmn:sequenceFlow id="Flow_16" name="Yes" sourceRef="g3" targetRef="e3" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="notify" targetRef="e4" />
  </bpmn:process>
  <bpmn:process id="Proc_part" isExecutable="false">
    <bpmn:startEvent id="rcv" name="Notification received">
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="rcv_msg" />
    </bpmn:startEvent>
    <bpmn:userTask id="open" name="Open event: what changes for me, change history">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e5" name="Informed">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="rcv" targetRef="open" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="open" targetRef="e5" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Pool_src_di" bpmnElement="Pool_src" isHorizontal="true"><dc:Bounds x="16" y="16" width="1300" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_crowded_di" bpmnElement="Pool_crowded" isHorizontal="true"><dc:Bounds x="16" y="96" width="1300" height="620" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_O_di" bpmnElement="Lane_O" isHorizontal="true"><dc:Bounds x="46" y="96" width="1270" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_S_di" bpmnElement="Lane_S" isHorizontal="true"><dc:Bounds x="46" y="226" width="1270" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_K_di" bpmnElement="Lane_K" isHorizontal="true"><dc:Bounds x="46" y="406" width="1270" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_N_di" bpmnElement="Lane_N" isHorizontal="true"><dc:Bounds x="46" y="586" width="1270" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_part_di" bpmnElement="Pool_part" isHorizontal="true"><dc:Bounds x="16" y="736" width="1300" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="so_di" bpmnElement="so"><dc:Bounds x="420" y="143" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="393" y="184" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="orgpub_di" bpmnElement="orgpub"><dc:Bounds x="490" y="121" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="100" y="252" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="73" y="293" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fetch_di" bpmnElement="fetch"><dc:Bounds x="170" y="230" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="310" y="245" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="275" y="213" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="keep_di" bpmnElement="keep"><dc:Bounds x="345" y="320" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="480" y="342" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="453" y="383" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="520" y="245" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="485" y="200" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="600" y="342" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="573" y="383" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="match_di" bpmnElement="match"><dc:Bounds x="660" y="411" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gM_di" bpmnElement="gM" isMarkerVisible="true"><dc:Bounds x="800" y="426" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="765" y="378" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="corr_di" bpmnElement="corr"><dc:Bounds x="880" y="411" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eR_di" bpmnElement="eR"><dc:Bounds x="1030" y="433" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="474" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rec_di" bpmnElement="rec"><dc:Bounds x="880" y="501" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g3_di" bpmnElement="g3" isMarkerVisible="true"><dc:Bounds x="910" y="626" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="875" y="680" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e3_di" bpmnElement="e3"><dc:Bounds x="822" y="633" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="795" y="674" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify_di" bpmnElement="notify"><dc:Bounds x="1005" y="611" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e4_di" bpmnElement="e4"><dc:Bounds x="1160" y="633" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1133" y="674" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rcv_di" bpmnElement="rcv"><dc:Bounds x="1042" y="783" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1015" y="824" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="open_di" bpmnElement="open"><dc:Bounds x="1105" y="761" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e5_di" bpmnElement="e5"><dc:Bounds x="1250" y="783" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1223" y="824" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="136" y="270" /><di:waypoint x="170" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="280" y="270" /><di:waypoint x="310" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="360" y="270" /><di:waypoint x="520" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="366" y="252" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="335" y="295" /><di:waypoint x="335" y="360" /><di:waypoint x="345" y="360" /><bpmndi:BPMNLabel><dc:Bounds x="341" y="312" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="455" y="360" /><di:waypoint x="480" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="570" y="270" /><di:waypoint x="695" y="270" /><di:waypoint x="695" y="411" /><bpmndi:BPMNLabel><dc:Bounds x="576" y="252" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="545" y="295" /><di:waypoint x="545" y="360" /><di:waypoint x="600" y="360" /><bpmndi:BPMNLabel><dc:Bounds x="551" y="312" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="456" y="161" /><di:waypoint x="490" y="161" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="600" y="161" /><di:waypoint x="735" y="161" /><di:waypoint x="735" y="411" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="770" y="451" /><di:waypoint x="800" y="451" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="850" y="451" /><di:waypoint x="880" y="451" /><bpmndi:BPMNLabel><dc:Bounds x="852" y="433" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="990" y="451" /><di:waypoint x="1030" y="451" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="825" y="476" /><di:waypoint x="825" y="541" /><di:waypoint x="880" y="541" /><bpmndi:BPMNLabel><dc:Bounds x="831" y="500" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="935" y="581" /><di:waypoint x="935" y="626" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="960" y="651" /><di:waypoint x="1005" y="651" /><bpmndi:BPMNLabel><dc:Bounds x="966" y="633" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16"><di:waypoint x="910" y="651" /><di:waypoint x="858" y="651" /><bpmndi:BPMNLabel><dc:Bounds x="870" y="633" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17"><di:waypoint x="1115" y="651" /><di:waypoint x="1160" y="651" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18"><di:waypoint x="1078" y="801" /><di:waypoint x="1105" y="801" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19_di" bpmnElement="Flow_19"><di:waypoint x="1215" y="801" /><di:waypoint x="1250" y="801" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Msg_1_di" bpmnElement="Msg_1"><di:waypoint x="225" y="76" /><di:waypoint x="225" y="230" /><bpmndi:BPMNLabel><dc:Bounds x="231" y="150" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Msg_2_di" bpmnElement="Msg_2"><di:waypoint x="1060" y="691" /><di:waypoint x="1060" y="783" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
