<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_workflow_3b_organization_during_event" targetNamespace="https://crowded.example/bpmn" exporter="crowded-labdsof" exporterVersion="1.0">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool_crowded" name="Crowded" processRef="Proc_crowded" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_crowded" isExecutable="false">
    <bpmn:laneSet id="LaneSet_crowded">
      <bpmn:lane id="Lane_O" name="Organization">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rev</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_C" name="Crowded platform">
        <bpmn:flowNodeRef>pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="On-site situation">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g1" name="What needs to change?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="inp" name="Write brief input, e.g. &#x27;Gate B closed&#x27;">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="upd" name="Update crowd level and queues (backoffice)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="pub" name="Publish with source and last-update time">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="On-site info visible">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g2" name="AI service available?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="draft" name="Draft alert from input and event state">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="rev" name="Write the alert, or edit the AI draft, then approve">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="send" name="Send alert to connected participants (per their preferences), labelled &#x27;Organization&#x27;">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e2" name="Alert sent">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_2" name="Incident" sourceRef="g1" targetRef="inp" />
    <bpmn:sequenceFlow id="Flow_3" name="Crowd / queues" sourceRef="g1" targetRef="upd" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="upd" targetRef="pub" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="pub" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="inp" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="g2" targetRef="draft" />
    <bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="g2" targetRef="rev" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="draft" targetRef="rev" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="rev" targetRef="send" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="send" targetRef="e2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Pool_crowded_di" bpmnElement="Pool_crowded" isHorizontal="true"><dc:Bounds x="16" y="16" width="1270" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_O_di" bpmnElement="Lane_O" isHorizontal="true"><dc:Bounds x="46" y="16" width="1240" height="208" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_C_di" bpmnElement="Lane_C" isHorizontal="true"><dc:Bounds x="46" y="224" width="1240" height="312" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="107" y="52" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="83" y="89" width="81" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="210" y="47" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="91" y="28" width="130" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inp_di" bpmnElement="inp"><dc:Bounds x="314" y="28" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="upd_di" bpmnElement="upd"><dc:Bounds x="314" y="132" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pub_di" bpmnElement="pub"><dc:Bounds x="460" y="236" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="615" y="260" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="580" y="297" width="102" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="695" y="359" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="576" y="340" width="130" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="draft_di" bpmnElement="draft" bioc:stroke="#c4633f" bioc:fill="#fbeee8" color:background-color="#fbeee8" color:border-color="#c4633f"><dc:Bounds x="776" y="340" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rev_di" bpmnElement="rev"><dc:Bounds x="922" y="28" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="send_di" bpmnElement="send"><dc:Bounds x="1068" y="236" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="1223" y="260" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="1213" y="297" width="52" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="139" y="68" /><di:waypoint x="210" y="68" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="252" y="68" /><di:waypoint x="314" y="68" /><bpmndi:BPMNLabel><dc:Bounds x="258" y="50" width="54" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="231" y="89" /><di:waypoint x="231" y="172" /><di:waypoint x="314" y="172" /><bpmndi:BPMNLabel><dc:Bounds x="237" y="111" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="440" y="172" /><di:waypoint x="523" y="172" /><di:waypoint x="523" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="586" y="276" /><di:waypoint x="615" y="276" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="440" y="68" /><di:waypoint x="716" y="68" /><di:waypoint x="716" y="359" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="737" y="380" /><di:waypoint x="776" y="380" /><bpmndi:BPMNLabel><dc:Bounds x="743" y="362" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="716" y="401" /><di:waypoint x="716" y="484" /><di:waypoint x="955" y="484" /><di:waypoint x="955" y="108" /><bpmndi:BPMNLabel><dc:Bounds x="722" y="423" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="902" y="380" /><di:waypoint x="985" y="380" /><di:waypoint x="985" y="108" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1048" y="68" /><di:waypoint x="1131" y="68" /><di:waypoint x="1131" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1194" y="276" /><di:waypoint x="1223" y="276" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
