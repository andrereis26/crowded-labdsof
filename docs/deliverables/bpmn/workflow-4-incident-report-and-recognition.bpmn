      <bpmndi:BPMNShape id="eA0_di" bpmnElement="eA0"><dc:Bounds x="419" y="325" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="456" y="335" width="70" height="13" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ask_di" bpmnElement="ask"><dc:Bounds x="495" y="241" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ans_di" bpmnElement="ans"><dc:Bounds x="495" y="141" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conf_di" bpmnElement="conf"><dc:Bounds x="655" y="241" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gC_di" bpmnElement="gC" isMarkerVisible="true"><dc:Bounds x="815" y="260" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="790" y="244" width="150" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="show_di" bpmnElement="show"><dc:Bounds x="896" y="241" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eA1_di" bpmnElement="eA1"><dc:Bounds x="1061" y="265" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="1038" y="302" width="80" height="13" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eA2_di" bpmnElement="eA2"><dc:Bounds x="820" y="325" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="857" y="335" width="60" height="13" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="414" y="400" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="300" y="440" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="aig_di" bpmnElement="aig" bioc:stroke="#c4633f" bioc:fill="#fbeee8" color:background-color="#fbeee8" color:border-color="#c4633f"><dc:Bounds x="480" y="381" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rule_di" bpmnElement="rule"><dc:Bounds x="480" y="471" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inbox_di" bpmnElement="inbox"><dc:Bounds x="640" y="591" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="805" y="610" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="776" y="590" width="100" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="split_di" bpmnElement="split"><dc:Bounds x="763" y="686" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="res_di" bpmnElement="res"><dc:Bounds x="886" y="591" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g3_di" bpmnElement="g3" isMarkerVisible="true"><dc:Bounds x="1051" y="610" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="1022" y="657" width="100" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rec_di" bpmnElement="rec"><dc:Bounds x="1132" y="381" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="save_di" bpmnElement="save"><dc:Bounds x="1298" y="381" width="126" height="80" /></bpmndi:BPMNShape>
