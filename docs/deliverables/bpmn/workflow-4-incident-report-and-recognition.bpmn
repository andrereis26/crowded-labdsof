<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_workflow_4_incident_report_and_recognition" targetNamespace="https://crowded.example/bpmn" exporter="crowded-labdsof" exporterVersion="1.1">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool_crowded" name="Crowded" processRef="Proc_crowded" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_crowded" isExecutable="false">
    <bpmn:laneSet id="LaneSet_crowded">
      <bpmn:lane id="Lane_P" name="Participant (reporter)">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gLoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_V" name="Other connected participants">
        <bpmn:flowNodeRef>ans</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_C" name="Crowded platform">
        <bpmn:flowNodeRef>pg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eA0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eA1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eA2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_O" name="Organization">
        <bpmn:flowNodeRef>inbox</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Something happens on site">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="rep" name="Report: predefined category + optional description">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gLoc" name="Personal category, or location allowed and near the venue?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_L1</bpmn:outgoing>
      <bpmn:outgoing>Flow_L2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="msg" name="See: location is only used to ensure better report quality">
      <bpmn:incoming>Flow_L2</bpmn:incoming>
      <bpmn:outgoing>Flow_L3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="eL" name="Not submitted">
      <bpmn:incoming>Flow_L3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="pg1">
      <bpmn:incoming>Flow_L1</bpmn:incoming>
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
      <bpmn:outgoing>Flow_B1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gP" name="Category triggers prompts at this event?">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
      <bpmn:outgoing>Flow_A3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="eA0" name="Not prompted">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="ask" name="Ask a sample of connected users (not the reporter) to confirm">
      <bpmn:incoming>Flow_A3</bpmn:incoming>
      <bpmn:outgoing>Flow_A4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="ans" name="Answer &#x27;Yes&#x27; or &#x27;No&#x27; (only if near the venue)">
      <bpmn:incoming>Flow_A4</bpmn:incoming>
      <bpmn:outgoing>Flow_A5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="conf" name="Update confidence (Yes raises, No lowers, decays over time)">
      <bpmn:incoming>Flow_A5</bpmn:incoming>
      <bpmn:outgoing>Flow_A6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gC" name="Medium or High confidence?">
      <bpmn:incoming>Flow_A6</bpmn:incoming>
      <bpmn:outgoing>Flow_A7</bpmn:outgoing>
      <bpmn:outgoing>Flow_A8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="show" name="Show on event page as participant estimate + confidence">
      <bpmn:incoming>Flow_A7</bpmn:incoming>
      <bpmn:outgoing>Flow_A9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="eA1" name="Estimate shown">
      <bpmn:incoming>Flow_A9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="eA2" name="Kept hidden">
      <bpmn:incoming>Flow_A8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g1" name="AI service available?">
      <bpmn:incoming>Flow_B1</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="aig" name="Group similar reports into one incident + summary">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="rule" name="Group by category, location and time window">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="inbox" name="Review incident in inbox (with confidence)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Grouped correctly?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="split" name="Split the group">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="res" name="Acknowledge and resolve, or send an alert">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="Marked as helpful?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="rec" name="Send recognition with impact, e.g. &#x27;alert sent to 850&#x27;">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="save" name="Save in private contribution history">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Recognised">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="upd" name="Notify reporter of resolution">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e2" name="Resolved">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="noteP">
      <bpmn:text>The organization chooses per event which predefined categories trigger prompts (defaults when the event has no organization). Personal categories (e.g. lost and found) never do.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_P" sourceRef="gP" targetRef="noteP" />
    <bpmn:textAnnotation id="noteA">
      <bpmn:text>Sample: users with location allowed, never the reporter; each asked at most once per period, can turn prompts off per event. One anonymous answer per user; location checked once, not stored.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_A" sourceRef="ask" targetRef="noteA" />
    <bpmn:textAnnotation id="noteS">
      <bpmn:text>Always labelled as an estimate that may not reflect reality. Crowd level and queue estimates only when the organization has no current value. Hidden again if confidence drops.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_S" sourceRef="show" targetRef="noteS" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="rep" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="rep" targetRef="gLoc" />
    <bpmn:sequenceFlow id="Flow_L1" name="Yes" sourceRef="gLoc" targetRef="pg1" />
    <bpmn:sequenceFlow id="Flow_L2" name="No" sourceRef="gLoc" targetRef="msg" />
    <bpmn:sequenceFlow id="Flow_L3" sourceRef="msg" targetRef="eL" />
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="pg1" targetRef="gP" />
    <bpmn:sequenceFlow id="Flow_A2" name="No" sourceRef="gP" targetRef="eA0" />
    <bpmn:sequenceFlow id="Flow_A3" name="Yes" sourceRef="gP" targetRef="ask" />
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="ask" targetRef="ans" />
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="ans" targetRef="conf" />
    <bpmn:sequenceFlow id="Flow_A6" sourceRef="conf" targetRef="gC" />
    <bpmn:sequenceFlow id="Flow_A7" name="Yes" sourceRef="gC" targetRef="show" />
    <bpmn:sequenceFlow id="Flow_A8" name="No" sourceRef="gC" targetRef="eA2" />
    <bpmn:sequenceFlow id="Flow_A9" sourceRef="show" targetRef="eA1" />
    <bpmn:sequenceFlow id="Flow_B1" sourceRef="pg1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_3" name="Yes" sourceRef="g1" targetRef="aig" />
    <bpmn:sequenceFlow id="Flow_4" name="No" sourceRef="g1" targetRef="rule" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="aig" targetRef="inbox" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="rule" targetRef="inbox" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="inbox" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="g2" targetRef="split" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="split" targetRef="inbox" />
    <bpmn:sequenceFlow id="Flow_10" name="Yes" sourceRef="g2" targetRef="res" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="res" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="g3" targetRef="rec" />
    <bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="g3" targetRef="upd" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="rec" targetRef="save" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="save" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="upd" targetRef="e2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Pool_crowded_di" bpmnElement="Pool_crowded" isHorizontal="true"><dc:Bounds x="16" y="16" width="1560" height="760" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P_di" bpmnElement="Lane_P" isHorizontal="true"><dc:Bounds x="46" y="16" width="1530" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_V_di" bpmnElement="Lane_V" isHorizontal="true"><dc:Bounds x="46" y="126" width="1530" height="110" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_C_di" bpmnElement="Lane_C" isHorizontal="true"><dc:Bounds x="46" y="236" width="1530" height="330" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_O_di" bpmnElement="Lane_O" isHorizontal="true"><dc:Bounds x="46" y="566" width="1530" height="210" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="107" y="55" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="80" y="92" width="86" height="26" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
