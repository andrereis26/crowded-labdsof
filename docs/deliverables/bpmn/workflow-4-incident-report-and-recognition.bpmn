      <bpmndi:BPMNShape id="noteP_di" bpmnElement="noteP"><dc:Bounds x="130" y="136" width="300" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="noteA_di" bpmnElement="noteA"><dc:Bounds x="660" y="136" width="300" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="noteS_di" bpmnElement="noteS"><dc:Bounds x="1130" y="246" width="320" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Assoc_P_di" bpmnElement="Assoc_P"><di:waypoint x="428" y="267" /><di:waypoint x="380" y="206" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_A_di" bpmnElement="Assoc_A"><di:waypoint x="621" y="255" /><di:waypoint x="700" y="196" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_S_di" bpmnElement="Assoc_S"><di:waypoint x="1022" y="260" /><di:waypoint x="1130" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="139" y="71" /><di:waypoint x="168" y="71" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="294" y="71" /><di:waypoint x="333" y="71" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L1_di" bpmnElement="Flow_L1"><di:waypoint x="354" y="92" /><di:waypoint x="354" y="260" /><bpmndi:BPMNLabel><dc:Bounds x="330" y="160" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_di" bpmnElement="Flow_L2"><di:waypoint x="375" y="71" /><di:waypoint x="414" y="71" /><bpmndi:BPMNLabel><dc:Bounds x="382" y="53" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_di" bpmnElement="Flow_L3"><di:waypoint x="540" y="61" /><di:waypoint x="580" y="61" /></bpmndi:BPMNEdge>
