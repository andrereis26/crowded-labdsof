<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_workflow_1_connect_to_event" targetNamespace="https://crowded.example/bpmn" exporter="crowded-labdsof" exporterVersion="1.0">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool_crowded" name="Crowded" processRef="Proc_Pool_crowded" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Pool_crowded" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Pool_crowded">
      <bpmn:lane id="Lane_P" name="Participant">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>code</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>type</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_C" name="Crowded platform">
        <bpmn:flowNodeRef>findc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>qr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noqr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>noev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Wants to reach an event's page">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g1" name="Ticketed or public?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="code" name="Scan the QR code or type the access code">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="up" name="Upload the ticket PDF or a screenshot">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="findc" name="Find the public event by its access code">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gc" name="Access code found?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="qr" name="Decode the ticket's QR code (no AI)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gq" name="QR code found?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="noqr" name="Ticket refused: no QR code">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gai" name="AI service available?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ai" name="Extract the event code, without personal data">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gm" name="Code matches a registered event?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="type" name="Type the event code printed on the ticket">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gm2" name="Typed code matches?">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="noev" name="Event does not use Crowded: ticket not stored">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="link" name="Link the ticket to the event (one account per QR code)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="sum" name="Add to my events; show the registered event's details">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Event in my events">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_2" name="Ticketed" sourceRef="g1" targetRef="up" />
    <bpmn:sequenceFlow id="Flow_3" name="Public" sourceRef="g1" targetRef="code" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="code" targetRef="findc" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="up" targetRef="qr" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="findc" targetRef="gc" />
    <bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="gc" targetRef="sum" />
    <bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="gc" targetRef="code" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="qr" targetRef="gq" />
    <bpmn:sequenceFlow id="Flow_10" name="No" sourceRef="gq" targetRef="noqr" />
    <bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="gq" targetRef="gai" />
    <bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="gai" targetRef="ai" />
    <bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="gai" targetRef="type" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="ai" targetRef="gm" />
    <bpmn:sequenceFlow id="Flow_15" name="Yes" sourceRef="gm" targetRef="link" />
    <bpmn:sequenceFlow id="Flow_16" name="No" sourceRef="gm" targetRef="type" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="type" targetRef="gm2" />
    <bpmn:sequenceFlow id="Flow_18" name="Yes" sourceRef="gm2" targetRef="link" />
    <bpmn:sequenceFlow id="Flow_19" name="No" sourceRef="gm2" targetRef="noev" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="link" targetRef="sum" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="sum" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Pool_crowded_di" bpmnElement="Pool_crowded" isHorizontal="true"><dc:Bounds x="16" y="16" width="1660" height="538" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P_di" bpmnElement="Lane_P" isHorizontal="true"><dc:Bounds x="46" y="16" width="1630" height="208" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_C_di" bpmnElement="Lane_C" isHorizontal="true"><dc:Bounds x="46" y="224" width="1630" height="330" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="107" y="156" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="58" y="193" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="187" y="151" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="143" y="198" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
