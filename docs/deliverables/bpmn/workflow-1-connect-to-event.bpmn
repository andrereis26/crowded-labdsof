      <bpmndi:BPMNShape id="up_di" bpmnElement="up"><dc:Bounds x="268" y="132" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="findc_di" bpmnElement="findc"><dc:Bounds x="420" y="236" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gc_di" bpmnElement="gc" isMarkerVisible="true"><dc:Bounds x="580" y="255" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="536" y="302" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="qr_di" bpmnElement="qr"><dc:Bounds x="420" y="340" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gq_di" bpmnElement="gq" isMarkerVisible="true"><dc:Bounds x="580" y="359" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="536" y="406" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="noqr_di" bpmnElement="noqr"><dc:Bounds x="585" y="468" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="536" y="505" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gai_di" bpmnElement="gai" isMarkerVisible="true"><dc:Bounds x="680" y="359" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="636" y="406" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ai_di" bpmnElement="ai" bioc:stroke="#c4633f" bioc:fill="#fbeee8" color:background-color="#fbeee8" color:border-color="#c4633f"><dc:Bounds x="760" y="340" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gm_di" bpmnElement="gm" isMarkerVisible="true"><dc:Bounds x="930" y="359" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="886" y="406" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="type_di" bpmnElement="type"><dc:Bounds x="1010" y="132" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gm2_di" bpmnElement="gm2" isMarkerVisible="true"><dc:Bounds x="1170" y="463" width="42" height="42" /><bpmndi:BPMNLabel><dc:Bounds x="1126" y="510" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="noev_di" bpmnElement="noev"><dc:Bounds x="1290" y="468" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="1241" y="505" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="link_di" bpmnElement="link"><dc:Bounds x="1260" y="340" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sum_di" bpmnElement="sum"><dc:Bounds x="1430" y="236" width="126" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e"><dc:Bounds x="1600" y="260" width="32" height="32" /><bpmndi:BPMNLabel><dc:Bounds x="1551" y="297" width="130" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="139" y="172" /><di:waypoint x="187" y="172" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="229" y="172" /><di:waypoint x="268" y="172" /><bpmndi:BPMNLabel><dc:Bounds x="235" y="154" width="56" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="208" y="151" /><di:waypoint x="208" y="68" /><di:waypoint x="268" y="68" /><bpmndi:BPMNLabel><dc:Bounds x="214" y="102" width="42" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="394" y="68" /><di:waypoint x="407" y="68" /><di:waypoint x="407" y="276" /><di:waypoint x="420" y="276" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="331" y="212" /><di:waypoint x="331" y="380" /><di:waypoint x="420" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="546" y="276" /><di:waypoint x="580" y="276" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="622" y="276" /><di:waypoint x="1430" y="276" /><bpmndi:BPMNLabel><dc:Bounds x="628" y="258" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="601" y="255" /><di:waypoint x="601" y="40" /><di:waypoint x="394" y="40" /><bpmndi:BPMNLabel><dc:Bounds x="607" y="140" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="546" y="380" /><di:waypoint x="580" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="601" y="401" /><di:waypoint x="601" y="468" /><bpmndi:BPMNLabel><dc:Bounds x="607" y="448" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="622" y="380" /><di:waypoint x="680" y="380" /><bpmndi:BPMNLabel><dc:Bounds x="628" y="362" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="722" y="380" /><di:waypoint x="760" y="380" /><bpmndi:BPMNLabel><dc:Bounds x="728" y="362" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="701" y="359" /><di:waypoint x="701" y="172" /><di:waypoint x="1010" y="172" /><bpmndi:BPMNLabel><dc:Bounds x="707" y="258" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="886" y="380" /><di:waypoint x="930" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="972" y="380" /><di:waypoint x="1260" y="380" /><bpmndi:BPMNLabel><dc:Bounds x="978" y="362" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16"><di:waypoint x="951" y="359" /><di:waypoint x="951" y="172" /><di:waypoint x="1010" y="172" /><bpmndi:BPMNLabel><dc:Bounds x="957" y="258" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
