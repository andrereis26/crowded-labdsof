@startuml logical-view-level-2
' Crowded — Logical View, Level 2 (C4 container view in UML component notation)
' Sources: requirements.md (TR-001..TR-005, NFR-001..NFR-008, SR-010..SR-012), domain-model.puml

title Crowded — Logical View (Level 2)

skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam nodesep 70
skinparam linetype polyline
skinparam ranksep 80

skinparam component {
  BackgroundColor #BFEFFF
  BorderColor #333333
  BackgroundColor<<C4 Container>> #FFFFC0
  BackgroundColor<<External System>> #EEEEEE
}
skinparam interface {
  BackgroundColor #6EC8F0
  BorderColor #333333
}
skinparam port {
  BackgroundColor #6EC8F0
  BorderColor #333333
}

' ---------------------------------------------------------------------
' Actors and external systems
' ---------------------------------------------------------------------


() "Ticketing Source API" as ITicketing
() "Maps & Transport API" as IMaps
() "Weather API" as IWeatherMobile
() "Weather API" as IWeather
() "AI API" as IAI
() "Push API" as IPush
() "Organization Integration API" as IOrgIntegration
() "Mobile UI" as MobileUI
() "Backoffice UI" as BackofficeUI

' ---------------------------------------------------------------------
' Crowded system
' ---------------------------------------------------------------------
component "Crowded" <<C4 Container>> as Crowded {

  portin "Mobile UI" as pMobileUI
  portin "Backoffice UI" as pBackofficeUI
  portin "Organization API" as pOrgApi
  portin "Maps & Transport" as pMaps
  portin "Weather" as pMobileWeather

  portout "Ticketing" as pTicketing
  portout "Weather" as pWeather
  portout "AI" as pAI
  portout "Push" as pPush

  component "Mobile App" as Mobile
  component "Backoffice Web App" as Backoffice

  component "Router\n(NGINX)" as Router
  () "Gateway" as IGateway

  component "Core" as Core
  () "REST API Core" as ICoreApi
  () "Live Updates\n(SSE / WebSocket)" as ICoreLive

  component "Notifications" as Notifications
  () "REST API Notifications" as INotifApi

  component "Jobs" as Jobs

  component "Message Broker" as Broker
  () "Messaging API" as IMessaging

  component "Database" as Database
  () "SQL" as ISql

  ' --- Clients and entry point
  pMobileUI -down- Mobile
  pBackofficeUI -down- Backoffice
  Router -up- IGateway
  Mobile -down-( IGateway
  Backoffice -down-( IGateway
  pOrgApi -down-( IGateway

  ' --- Router routes to the public APIs
  Core -up- ICoreApi
  Core -up- ICoreLive
  Notifications -up- INotifApi
  Router -down-( ICoreApi
  Router -down-( ICoreLive
  Router -down-( INotifApi

  ' --- Asynchronous messaging
  Broker -up- IMessaging
  Core -down-( IMessaging : publish /\nconsume
  Jobs -down-( IMessaging : publish /\nconsume
  Notifications -down-( IMessaging : consume

  ' --- Data
  Database -up- ISql
  Core -down-( ISql
  Jobs -down-( ISql
  Notifications -down-( ISql

  ' --- Outbound integrations
  Jobs -down---- pTicketing
  Jobs -down---- pWeather
  Core -down---- pAI
  Jobs -down---- pAI
  Notifications -down---- pPush
  Mobile -up- pMaps
  Mobile -up- pMobileWeather

  ' --- Layout hints
  Jobs -[hidden]right- Core
  Core -[hidden]right- Notifications
  Broker -[hidden]right- Database
}

' --- Boundary wiring
pMobileUI -up- MobileUI
pBackofficeUI -up- BackofficeUI
pOrgApi -up- IOrgIntegration
pTicketing -down-( ITicketing
pWeather -down-( IWeather
pAI -down-( IAI
pPush -down-( IPush
pMaps -up-( IMaps
pMobileWeather -up-( IWeatherMobile


@enduml
