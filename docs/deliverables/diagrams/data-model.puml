@startuml data-model-erd

title Crowded - Data Model (ERD)

left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 11
}
skinparam nodesep 35
skinparam ranksep 45

' Core-owned domain data
package "Core" {

' Identity and access
entity "User" as User {
  * id : UUID <<PK>>
  organizationId : UUID [NULL] <<FK>>
  --
  name : TEXT [NULL] [PERSONAL]
  email : TEXT [PERSONAL]
  passwordHash : TEXT [CREDENTIAL]
  role : role
  active : BOOLEAN
  mustChangePassword : BOOLEAN
  temporaryPasswordExpiresAt : TIMESTAMPTZ [NULL]
  lastSignedInAt : TIMESTAMPTZ [NULL] [PERSONAL]
  createdAt : TIMESTAMPTZ
  locationConsentGranted : BOOLEAN [NULL] [PERSONAL]
}

note right of User
  [NULL] marks an optional (nullable) database column.
  name is the member's name, given by the administrator;
  participants register with their email only.
end note

entity "Organization" as Organization {
  * id : UUID <<PK>>
  createdByUserId : UUID [NULL] <<FK>> [PERSONAL]
  --
  name : TEXT <<UK>>
  createdAt : TIMESTAMPTZ
}

' Event catalog
entity "Event" as Event {
  * id : UUID <<PK>>
  organizationId : UUID <<FK>>
  --
  name : TEXT
  description : TEXT
  type : event_type
  ticketEventCode : TEXT [NULL]
  accessCode : TEXT [NULL]
  startDateTime : TIMESTAMPTZ
  doorsOpenAt : TIMESTAMPTZ [NULL]
  endDateTime : TIMESTAMPTZ
  status : event_status
  capacity : INTEGER [NULL]
  venueName : TEXT
  address : TEXT
  district : TEXT
  latitude : DOUBLE PRECISION
  longitude : DOUBLE PRECISION
  crowdLevel : crowd_level [NULL]
  headCount : INTEGER [NULL]
  crowdProvenanceSourceType : source_type [NULL]
  crowdProvenanceSourceName : TEXT [NULL]
  crowdProvenanceLastUpdatedAt : TIMESTAMPTZ [NULL]
  crowdProvenanceConfirmed : BOOLEAN [NULL]
}

note right of Event
  The composed EventLocation and optional CrowdStatus
  are flattened into Event columns. Provenance is
  flattened within CrowdStatus.
  A TICKETED event has ticketEventCode, the code printed
  on its tickets; a PUBLIC event has accessCode. Each code
  is unique among upcoming events, checked by Core (FR-086).
  district selects the IPMA warnings and forecast (FR-036).
end note

entity "EventChange" as EventChange {
  * id : UUID <<PK>>
  eventId : UUID <<FK>>
  --
  type : change_type
  severity : severity
  previousValue : JSONB
  newValue : JSONB
  ticketStillValid : BOOLEAN [NULL]
  refundInfo : TEXT [NULL]
  message : TEXT [NULL]
  provenanceSourceType : source_type
  provenanceSourceName : TEXT
  provenanceLastUpdatedAt : TIMESTAMPTZ
  provenanceConfirmed : BOOLEAN
}

note right of EventChange
  Each JSONB value stores the changed attribute and
  its old or new value (for example,
  {"status":"SCHEDULED"} to {"status":"POSTPONED"}).
  This supports changed attributes with different types.
  Every change is published by the owning organization
  (ADR 0015).
end note

' Participation
entity "EventConnection\n<<Abstract>>" as EventConnection {
  * id : UUID <<PK>>
  userId : UUID <<FK>> [PERSONAL]
  eventId : UUID <<FK>>
  --
  connectedAt : TIMESTAMPTZ
  lastPromptedAt : TIMESTAMPTZ [NULL]
}

entity "Ticket" as Ticket {
  * id : UUID <<PK, FK>>
  --
  gate : TEXT [NULL]
  sector : TEXT [NULL]
  seat : TEXT [NULL]
  entryCode : BYTEA [CREDENTIAL, ENCRYPTED]
  entryCodeHash : TEXT [CREDENTIAL]
  importMethod : import_method
  matchMethod : match_method
}

note right of Ticket
  entryCode is the ticket's QR code (FR-070), encrypted
  and treated as a credential per SR-018. entryCodeHash is
  a keyed hash, unique, that Core keys with the event, so
  one ticket links to one account per event (FR-084).
  A ticket is stored only once it is
  matched: an import waiting for the typed code is kept in
  Redis for 30 minutes, not here (FR-004, FR-083).
end note

entity "AccessCodeConnection" as AccessCodeConnection {
  * id : UUID <<PK, FK>>
}

entity "TicketExtraction" as TicketExtraction {
  * id : UUID <<PK>>
  ticketId : UUID <<FK, UK>> [PERSONAL]
  --
  extractedEventCode : TEXT [NULL]
  extractedFields : JSONB
  aiGenerated : BOOLEAN
  createdAt : TIMESTAMPTZ
}

note right of TicketExtraction
  JSONB keeps the extracted gate, sector and seat
  grouped together. The stored data follows
  the validated extraction schema where personal data and
  entry codes are excluded (SR-004, SR-018).
end note

' On-site information
entity "QueueTime\n<<Dependent Value Object>>" as QueueTime {
  * id : UUID <<PK>>
  eventId : UUID <<FK, UK>>
  kind : queue_point_kind <<UK>>
  pointName : TEXT <<UK>>
  --
  waitMinutes : INTEGER
  provenanceSourceType : source_type
  provenanceSourceName : TEXT
  provenanceLastUpdatedAt : TIMESTAMPTZ
  provenanceConfirmed : BOOLEAN
}

entity "WeatherForecast\n<<Dependent Value Object>>" as WeatherForecast {
  * id : UUID <<PK>>
  eventId : UUID <<FK, UK>>
  date : DATE <<UK>>
  --
  conditions : TEXT
  minTemperature : DOUBLE PRECISION
  maxTemperature : DOUBLE PRECISION
  precipitationProbability : DOUBLE PRECISION [PERCENT]
  provenanceSourceType : source_type
  provenanceSourceName : TEXT
  provenanceLastUpdatedAt : TIMESTAMPTZ
  provenanceConfirmed : BOOLEAN
}

entity "WeatherWarning" as WeatherWarning {
  * id : UUID <<PK>>
  eventId : UUID <<FK, UK>>
  awarenessType : TEXT <<UK>>
  startTime : TIMESTAMPTZ <<UK>>
  --
  level : warning_level
  endTime : TIMESTAMPTZ
  notifiedLevel : warning_level [NULL]
  provenanceSourceType : source_type
  provenanceSourceName : TEXT
  provenanceLastUpdatedAt : TIMESTAMPTZ
  provenanceConfirmed : BOOLEAN
}

note right of WeatherWarning
  An IPMA warning for the event's district. notifiedLevel
  records the highest level already notified, so a warning
  is notified once per level (FR-036, NFR-003).
end note

' Organizer communication
entity "Alert" as Alert {
  * id : UUID <<PK>>
  eventId : UUID <<FK>>
  organizationId : UUID <<FK>>
  incidentId : UUID [NULL] <<FK>>
  --
  type : alert_type
  severity : severity
  message : TEXT
  status : alert_status
  sentAt : TIMESTAMPTZ [NULL]
  resolvedAt : TIMESTAMPTZ [NULL]
  recipientsCount : INTEGER [NULL]
}

entity "AlertDraft" as AlertDraft {
  * id : UUID <<PK>>
  alertId : UUID <<FK, UK>>
  --
  organizerInput : TEXT
  draftText : TEXT
  factsUsed : JSONB
  aiGenerated : BOOLEAN
}

note right of AlertDraft
  JSONB keeps the structured facts used by the draft
  so the UI can highlight them and show their source
  alongside the draft (FR-021, AI assessment).
end note

entity "EventSurvey" as EventSurvey {
  * id : UUID <<PK>>
  eventId : UUID <<FK>>
  --
  type : survey_type
  text : TEXT
  urgent : BOOLEAN
  publishedAt : TIMESTAMPTZ
  closesAt : TIMESTAMPTZ [NULL]
}

entity "SurveyOption\n<<Dependent Value Object>>" as SurveyOption {
  * id : UUID <<PK>>
  eventSurveyId : UUID <<FK, UK>>
  label : TEXT <<UK>>
}

entity "SurveyResponse" as SurveyResponse {
  * id : UUID <<PK>>
  eventSurveyId : UUID <<FK, UK>>
  userId : UUID <<FK, UK>> [PERSONAL]
  --
  answer : TEXT
  respondedAt : TIMESTAMPTZ
}

' Reports, confirmations and incidents
entity "Report" as Report {
  * id : UUID <<PK>>
  eventId : UUID <<FK>>
  userId : UUID <<FK>> [PERSONAL, PRIVACY-SENSITIVE]
  reportCategoryCode : TEXT <<FK>>
  incidentId : UUID [NULL] <<FK>>
  --
  description : TEXT [NULL] [MAY CONTAIN PERSONAL DATA]
  reportedCrowdLevel : crowd_level [NULL]
  reportedQueuePoint : TEXT [NULL]
  reportedWaitMinutes : INTEGER [NULL]
  reportedAt : TIMESTAMPTZ
  locationVerified : BOOLEAN [PERSONAL]
  confidenceScore : DOUBLE PRECISION
  confidenceLevel : confidence_level
  confidenceComputedAt : TIMESTAMPTZ
}

note right of Report
  The text description may contain personal data,
  for example when a lost and found report describes
  a personal belonging.
  The reporter link is additionally privacy-sensitive
  because SR-007 says the identity must not be public.
end note

entity "ReportCategory" as ReportCategory {
  * code : TEXT <<PK>>
  --
  name : TEXT
  personal : BOOLEAN
  promptsEnabledByDefault : BOOLEAN
}

entity "EventCategorySetting" as EventCategorySetting {
  * id : UUID <<PK>>
  eventId : UUID <<FK, UK>>
  reportCategoryCode : TEXT <<FK, UK>>
  --
  promptsEnabled : BOOLEAN
}

note right of EventCategorySetting
  A UK on multiple attributes of one entity denotes
  one composite unique constraint across those fields.
end note

entity "Confirmation" as Confirmation {
  * id : UUID <<PK>>
  reportId : UUID <<FK, UK>>
  userId : UUID <<FK, UK>> [PERSONAL, PRIVACY-SENSITIVE]
  --
  answer : confirmation_answer
  answeredAt : TIMESTAMPTZ
  locationVerified : BOOLEAN [PERSONAL]
}

note right of Confirmation
  userId links the response internally for the
  one-answer-per-user rule; the domain describes
  the answer as anonymous.
end note

entity "Incident" as Incident {
  * id : UUID <<PK>>
  eventId : UUID <<FK>>
  --
  summary : TEXT
  status : incident_status
  groupingMethod : grouping_method
  createdAt : TIMESTAMPTZ
}

entity "Recognition" as Recognition {
  * id : UUID <<PK>>
  reportId : UUID <<FK, UK>>
  --
  impact : TEXT
  reachedUsers : INTEGER [NULL]
  grantedAt : TIMESTAMPTZ
}

entity "AuditLogEntry" as AuditLogEntry {
  * id : UUID <<PK>>
  actorId : UUID [NULL] <<FK>> [PERSONAL]
  eventId : UUID [NULL] <<FK>>
  --
  action : TEXT
  entityType : TEXT
  entityId : UUID
  details : JSONB
  occurredAt : TIMESTAMPTZ
}

note right of AuditLogEntry
  JSONB stores structured details that vary by audit
  event type (event change, alert sent, incident status
  change, an administrator's account action), as covered
  by SR-006.
end note

entity "Outbox" as Outbox {
  * id : UUID <<PK>>
  --
  routingKey : TEXT
  payload : JSONB
  createdAt : TIMESTAMPTZ
}

note right of Outbox
  Messages Core committed with a change and RabbitMQ has
  not confirmed yet (Asynchronous Flows). The relay publishes
  each with id as its message id, then deletes it.
end note

}

' Notifications-owned data
package "Notifications" {
entity "Notification" as Notification {
  * id : UUID <<PK>>
  userId : UUID <<FK>> [PERSONAL]
  eventId : UUID <<FK>>
  --
  type : notification_type
  causeId : UUID [NULL]
  title : TEXT
  body : TEXT
  deduplicationKey : TEXT <<UK>> [PERSONAL]
  createdAt : TIMESTAMPTZ
  deliveredAt : TIMESTAMPTZ [NULL]
  readAt : TIMESTAMPTZ [NULL]
}

note right of Notification
  causeId identifies the disruption that triggered the
  notification; the type says which table it refers to
  (OFFICIAL_CHANGE: EventChange, OPERATIONAL_ALERT: Alert,
  WEATHER_WARNING: WeatherWarning, INCIDENT_STATUS: Incident). It has no FK because those
  tables belong to Core and the id arrives in the message
  (ADR 0002, ADR 0003). It links delivery to its cause
  for traceability and for measuring NFR-001.
end note

entity "UserNotificationSetting" as UserNotificationSetting {
  * id : UUID <<PK>>
  userId : UUID <<FK, UK>> [PERSONAL]
  type : notification_type <<UK>>
  --
  enabled : BOOLEAN
}

entity "EventNotificationSetting" as EventNotificationSetting {
  * id : UUID <<PK>>
  eventConnectionId : UUID <<FK, UK>> [PERSONAL]
  type : notification_type <<UK>>
  --
  enabled : BOOLEAN
}

}

' PostgreSQL enum types and domain values
package "ENUM types" {
enum "role" as role {
  PARTICIPANT
  ORGANIZATION_MEMBER
  ADMINISTRATOR
}

enum "event_status" as event_status {
  SCHEDULED
  POSTPONED
  RELOCATED
  CANCELLED
  ONGOING
  ENDED
}

enum "event_type" as event_type {
  TICKETED
  PUBLIC
}

enum "change_type" as change_type {
  CANCELLATION
  POSTPONEMENT
  TIME_CHANGE
  VENUE_CHANGE
  DETAILS_UPDATE
}

enum "import_method" as import_method {
  PDF_UPLOAD
  IMAGE_UPLOAD
}

enum "match_method" as match_method {
  EXTRACTED_CODE
  TYPED_CODE
}

enum "warning_level" as warning_level {
  YELLOW
  ORANGE
  RED
}

enum "crowd_level" as crowd_level {
  LOW
  MODERATE
  HIGH
  FULL
}

enum "queue_point_kind" as queue_point_kind {
  ENTRANCE
  TICKET_OFFICE
  BAR
  TOILET
  OTHER
}

enum "source_type" as source_type {
  OFFICIAL_SOURCE
  ORGANIZATION
  PARTICIPANT_ESTIMATE
  AI_GENERATED
  EXTERNAL_SERVICE
}

enum "alert_type" as alert_type {
  ENTRANCE_CLOSURE
  CAPACITY_REACHED
  SCHEDULE_DELAY
  WEATHER_WARNING
  OTHER
}

enum "alert_status" as alert_status {
  DRAFT
  SENT
}

enum "severity" as severity {
  CRITICAL
  WARNING
  INFO
}

enum "survey_type" as survey_type {
  CONFIRMATION
  CHOICE
  IDEA
}

enum "confirmation_answer" as confirmation_answer {
  YES
  NO
}

enum "confidence_level" as confidence_level {
  LOW
  MEDIUM
  HIGH
}

enum "incident_status" as incident_status {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum "grouping_method" as grouping_method {
  AI_SIMILARITY
  CATEGORY_TIME_WINDOW
  MANUAL_SPLIT
}

enum "notification_type" as notification_type {
  OFFICIAL_CHANGE
  OPERATIONAL_ALERT
  ORGANIZATION_SURVEY
  WEATHER_WARNING
  INCIDENT_STATUS
  RECOGNITION
  CONFIRMATION_REQUEST
}
}

' Identity and access relationships
Organization |o--|{ User : members
User |o--o{ Organization : creates (administrator)

' Event catalog relationships
Organization ||--o{ Event : owns
Event ||--o{ EventChange : change history

' Participation relationships
User ||--o{ EventConnection : connects
Event ||--o{ EventConnection : has participants
EventConnection ||--o| Ticket : subtype
EventConnection ||--o| AccessCodeConnection : subtype
Ticket ||--o| TicketExtraction : extraction

' On-site information relationships
Event ||--o{ QueueTime : queues
Event ||--o{ WeatherForecast : forecasts
Event ||--o{ WeatherWarning : warnings

' Organizer communication relationships
Event ||--o{ Alert : alerts
Alert ||--o| AlertDraft : draft
Organization ||--o{ Alert : approves and sends
Event ||--o{ EventSurvey : surveys
EventSurvey ||--o{ SurveyOption : options
EventSurvey ||--o{ SurveyResponse : responses
User ||--o{ SurveyResponse : responds

' Reports, confirmations and incidents relationships
Event ||--o{ Report : reports
User ||--o{ Report : reports (identity not public)
ReportCategory ||--o{ Report : classifies
Event ||--o{ EventCategorySetting : category settings
ReportCategory ||--o{ EventCategorySetting : configured category
Report ||--o{ Confirmation : confirmations
User ||--o{ Confirmation : answers (anonymous)
Event ||--o{ Incident : incidents
Incident |o--|{ Report : groups
Incident |o--o{ Alert : may trigger
Report ||--o| Recognition : recognition

' Notifications and audit relationships
User ||--o{ UserNotificationSetting : overall defaults
EventConnection ||--o{ EventNotificationSetting : per-event overrides
User ||--o{ Notification : receives
Event ||--o{ Notification : concerns
User |o--o{ AuditLogEntry : actor
Event ||--o{ AuditLogEntry : records changes

@enduml
