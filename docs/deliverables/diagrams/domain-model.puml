@startuml domain-model

title Crowded — Domain Model

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
hide empty members
hide circle

skinparam class {
  BackgroundColor<<Aggregate Root>> #FFF2CC
  BorderColor<<Aggregate Root>> #B8860B
  BackgroundColor<<Entity>> #DAE8FC
  BackgroundColor<<Value Object>> #E1F5E1
}

' =====================================================================
' Identity & Access
' =====================================================================
package "Identity & Access" {
  class User <<Aggregate Root>> {
    id
    email
    passwordHash
    role : Role
    active : boolean
    mustChangePassword : boolean
    createdAt
  }

  class LocationConsent <<Value Object>> {
    granted : boolean
    approximateLocation : GeoLocation [0..1]
    manualLocation : String [0..1]
  }

  class Organization <<Aggregate Root>> {
    id
    name
    createdAt
  }

  enum Role {
    PARTICIPANT
    ORGANIZATION_MEMBER
    ADMINISTRATOR
  }
}

' =====================================================================
' Event Catalog & Official Changes
' =====================================================================
package "Event Catalog" {
  class Event <<Aggregate Root>> {
    id
    name
    description
    type : EventType
    ticketEventCode [0..1]
    accessCode [0..1]
    startDateTime
    doorsOpenAt [0..1]
    endDateTime
    status : EventStatus
    capacity : int [0..1]
  }

  class ConfirmationSettings <<Value Object>> {
    promptCategories : ReportCategory [0..*]
    venueRadiusMeters : int
    highConfidenceAnswers : int
    maxPromptsPerHour : int
  }

  class QueuePoint <<Value Object>> {
    name
  }

  class EventLocation <<Value Object>> {
    venueName
    address
    district
    coordinates : GeoLocation
  }

  class EventChange <<Entity>> {
    id
    type : ChangeType
    severity : Severity
    previousValue
    newValue
    ticketStillValid : boolean [0..1]
    refundInfo [0..1]
    provenance : Provenance
  }

  enum EventType {
    TICKETED
    PUBLIC
  }

  enum EventStatus {
    SCHEDULED
    POSTPONED
    RELOCATED
    CANCELLED
    ONGOING
    ENDED
  }

  enum ChangeType {
    CANCELLATION
    POSTPONEMENT
    TIME_CHANGE
    VENUE_CHANGE
    DETAILS_UPDATE
  }

  enum Severity {
    CRITICAL
    WARNING
    INFO
  }
}

' =====================================================================
' Participation (tickets & access codes)
' =====================================================================
package "Participation" {
  abstract class EventConnection <<Aggregate Root>> {
    id
    connectedAt
    lastPromptedAt [0..1]
  }

  class Ticket <<Entity>> {
    gate [0..1]
    sector [0..1]
    seat [0..1]
    entryCode [encrypted]
    entryCodeHash
    importMethod : ImportMethod
    matchMethod : MatchMethod
  }

  class AccessCodeConnection <<Entity>> {
  }

  class TicketExtraction <<Entity>> {
    id
    extractedEventCode [0..1]
    extractedFields
    aiGenerated : boolean
    createdAt
  }

  enum ImportMethod {
    PDF_UPLOAD
    IMAGE_UPLOAD
  }

  enum MatchMethod {
    EXTRACTED_CODE
    TYPED_CODE
  }
}

' =====================================================================
' On-Site Information
' =====================================================================
package "On-Site Information" {
  class CrowdStatus <<Value Object>> {
    level : CrowdLevel
    headCount : int [0..1]
    provenance : Provenance
  }

  class QueueTime <<Value Object>> {
    queuePoint : QueuePoint
    waitMinutes : int
    provenance : Provenance
  }

  class WeatherForecast <<Value Object>> {
    date
    conditions
    minTemperature
    maxTemperature
    precipitationProbability
    provenance : Provenance
  }

  class WeatherWarning <<Entity>> {
    id
    awarenessType
    level : WarningLevel
    startTime
    endTime
    provenance : Provenance
  }

  enum WarningLevel {
    YELLOW
    ORANGE
    RED
  }

  class Provenance <<Value Object>> {
    sourceType : SourceType
    sourceName
    lastUpdatedAt
    confirmed : boolean
  }

  enum CrowdLevel {
    LOW
    MODERATE
    HIGH
    FULL
  }

  enum SourceType {
    OFFICIAL_SOURCE
    ORGANIZATION
    PARTICIPANT_ESTIMATE
    AI_GENERATED
    EXTERNAL_SERVICE
  }
}

' =====================================================================
' Organizer Communication
' =====================================================================
package "Organizer Communication" {
  class Alert <<Aggregate Root>> {
    id
    type : AlertType
    severity : Severity
    message
    status : AlertStatus
    sentAt [0..1]
    resolvedAt [0..1]
    recipientsCount [0..1]
  }

  class AlertDraft <<Entity>> {
    organizerInput
    draftText
    factsUsed
    aiGenerated : boolean
  }

  class EventSurvey <<Aggregate Root>> {
    id
    type : SurveyType
    text
    urgent : boolean
    publishedAt
    closesAt [0..1]
  }

  class SurveyOption <<Value Object>> {
    label
  }

  class SurveyResponse <<Entity>> {
    answer
    respondedAt
  }

  enum AlertType {
    ENTRANCE_CLOSURE
    CAPACITY_REACHED
    SCHEDULE_DELAY
    WEATHER_WARNING
    OTHER
  }

  enum AlertStatus {
    DRAFT
    SENT
  }

  enum SurveyType {
    CONFIRMATION
    CHOICE
    IDEA
  }
}

' =====================================================================
' Reports, Confirmations & Incidents
' =====================================================================
package "Reports & Incidents" {
  class Report <<Aggregate Root>> {
    id
    description [0..1]
    reportedCrowdLevel : CrowdLevel [0..1]
    reportedQueuePoint [0..1]
    reportedWaitMinutes : int [0..1]
    reportedAt
    locationVerified : boolean
    confidence : Confidence
  }

  class ReportCategory <<Entity>> {
    code
    name
    personal : boolean
    promptsEnabledByDefault : boolean
  }

  class EventCategorySetting <<Entity>> {
    promptsEnabled : boolean
  }

  class Confirmation <<Entity>> {
    answer : ConfirmationAnswer
    answeredAt
    locationVerified : boolean
  }

  class Confidence <<Value Object>> {
    score : float
    level : ConfidenceLevel
    computedAt
  }

  class Incident <<Aggregate Root>> {
    id
    summary
    status : IncidentStatus
    groupingMethod : GroupingMethod
    createdAt
  }

  class Recognition <<Entity>> {
    id
    impact
    reachedUsers : int [0..1]
    grantedAt
  }

  enum ConfirmationAnswer {
    YES
    NO
  }

  enum ConfidenceLevel {
    LOW
    MEDIUM
    HIGH
  }

  enum IncidentStatus {
    OPEN
    ACKNOWLEDGED
    RESOLVED
  }

  enum GroupingMethod {
    AI_SIMILARITY
    CATEGORY_TIME_WINDOW
    MANUAL_SPLIT
  }
}

' =====================================================================
' Notifications & Audit
' =====================================================================
package "Notifications & Audit" {
  class Notification <<Aggregate Root>> {
    id
    type : NotificationType
    title
    body
    deduplicationKey
    createdAt
    deliveredAt [0..1]
    readAt [0..1]
  }

  class NotificationSetting <<Value Object>> {
    type : NotificationType
    enabled : boolean
  }

  class AuditLogEntry <<Entity>> {
    id
    action
    entityType
    entityId
    actorId [0..1]
    details
    occurredAt
  }

  enum NotificationType {
    OFFICIAL_CHANGE
    OPERATIONAL_ALERT
    ORGANIZATION_SURVEY
    WEATHER_WARNING
    INCIDENT_STATUS
    RECOGNITION
    CONFIRMATION_REQUEST
  }
}

' =====================================================================
' Relationships
' Direction hints (-up-, -down-, -left-, -right-) place the packages around
' Event; [norank] keeps long "who did it" links from distorting the layout.
' =====================================================================

' --- Identity & Access (above Event)
User "1" *-down- "0..1" LocationConsent
Organization "0..1" -up-> "1..*" User : has members
User "0..1" -[norank]-> "0..*" Organization : creates, with members\n(administrator)

' --- Event Catalog (centre)
Organization "1" -down-> "0..*" Event : owns, the only source
Event "1" *-left- "1" EventLocation : held at
Event "1" *-left- "0..*" EventChange : change history

' --- Participation (right of Event)
EventConnection <|-down- Ticket
EventConnection <|-down- AccessCodeConnection
User "1" *-right- "0..*" EventConnection : my events
EventConnection "0..*" -left-> "1" Event : gives access to
Ticket "1" *-down- "0..1" TicketExtraction

' --- On-Site Information (below Event)
Event "1" *-down- "0..1" CrowdStatus : current crowd
Event "1" *-down- "0..*" QueuePoint : entrances and queue points (ordered)
Event "1" *-down- "1" ConfirmationSettings : report confirmations
Event "1" *-down- "0..*" QueueTime : current queues
Event "1" -down- "0..*" WeatherForecast
Event "1" -down- "0..*" WeatherWarning : for its district
CrowdStatus .down.> Provenance
QueueTime .down.> Provenance
EventChange .[norank].> Provenance
Provenance .down.> SourceType

' --- Organizer Communication (below right)
Event "1" -down- "0..*" Alert
Alert "1" *-down- "0..1" AlertDraft
Organization "1" -[norank]-> "0..*" Alert : approves & sends

Event "1" -down- "0..*" EventSurvey : event page
EventSurvey "1" *-down- "0..*" SurveyOption
EventSurvey "1" *-down- "0..*" SurveyResponse
User "1" -[norank]- "0..*" SurveyResponse

' --- Reports, confirmations & incidents (left of Event)
Event "1" -left- "0..*" Report
User "1" -[norank]-> "0..*" Report : reports\n(identity not public)
Report "0..*" -down-> "1" ReportCategory : classified as
Event "1" *-[norank]- "0..*" EventCategorySetting : set by organization
EventCategorySetting "0..*" -down-> "1" ReportCategory
Report "1" *-down- "0..*" Confirmation
User "1" -[norank]-> "0..*" Confirmation : answers\n(anonymous)
Report *-down- Confidence
Confidence .down.> ConfidenceLevel
Incident "1" o-down- "1..*" Report : groups
Event "1" -left- "0..*" Incident
Incident "0..1" -[norank]- "0..*" Alert : may trigger
Report "1" -down-> "0..1" Recognition : earns\n(when marked helpful)

' --- Notifications & Audit (above left)
User "1" *-left- "0..*" NotificationSetting : overall defaults
EventConnection "1" *-[norank]- "0..*" NotificationSetting : per-event overrides
User "1" -left-> "0..*" Notification : receives
Notification "0..*" .[norank].> "1" Event : about
AuditLogEntry "0..*" -right-> "0..1" User : actor
AuditLogEntry .[norank].> Event : records changes,\nalerts, incident status

' =====================================================================
' Notes (details in the technical design document)
' =====================================================================
note right of Provenance
  Source + last-update time on every piece of
  event information (FR-032); stale data flagged
  (FR-033); AI output labelled until confirmed (NFR-007).
end note

note bottom of Notification
  Sent only if the recipient's setting for its type is on
  (FR-041, FR-065). deduplicationKey = recipient + trigger,
  unique, so redelivered messages never notify twice (NFR-003).
  Each notification refers to the disruption that caused it
  (EventChange, Alert, WeatherWarning or Incident), so delivery can be traced
  and timed against NFR-001.
end note

note bottom of Incident
  Groups similar reports with AI, or by category
  and time window as fallback (FR-053).
end note

note bottom of Severity
  Disruptions are official changes (EventChange),
  organizer alerts (Alert) and reported incidents
  (Incident), and IPMA weather warnings. CRITICAL =
  cancellation, postponement, venue or start-time change,
  entrance closure, red warning (NFR-001); a doors-opening
  change or an orange warning is a WARNING
  (FR-072, FR-074).
end note

note top of Event
  TICKETED: ticketEventCode is the code printed on its
  tickets, matched from the extraction or typed (FR-003,
  FR-004). PUBLIC: accessCode given out by the organization,
  with a QR code (FR-085). Codes unique among upcoming
  events (FR-086). Only connected participants and the
  owning organization see the event (SR-020).
end note

note bottom of EventChange
  Published by the organization that owns the event,
  its only source of official information (FR-016,
  ADR 0015). Says what changes for the participant:
  ticket validity and refund information (FR-075).
end note

note bottom of Ticket
  entryCode is the ticket's QR code, decoded without AI
  (FR-070) and stored encrypted (SR-018); entryCodeHash
  is unique per event, so one ticket links to one
  account (FR-084).
end note

note right of Alert
  A sent alert stays active until the organization
  resolves it (e.g., the entrance reopens), which
  sets resolvedAt; connected users are told it
  ended (FR-073).
end note

note right of Confidence
  Rule-based (FR-058): YES raises, NO lowers,
  decays over time. MEDIUM/HIGH shown as
  participant estimates (FR-059).
end note

note bottom of ReportCategory
  Predefined categories; personal ones (lost and found)
  never prompt or show publicly (FR-059, FR-060).
end note

legend top left
  **Notation**
  A --> B : label   association, read as "A label B"
  A -- B            association without a reading direction
  A *-- B           composition (B cannot exist without A)
  A o-- B           aggregation (A groups existing B)
  A <|-- B          B is a kind of A
  A ..> B           dependency (A uses / is based on B)
endlegend

@enduml
