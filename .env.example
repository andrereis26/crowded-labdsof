# Local configuration of Crowded, read by the scripts in scripts/local/.
# scripts/local/setup.sh (setup.ps1 on Windows) copies this file to .env and
# fills every empty secret below with a freshly generated random value. .env is
# git-ignored; this file holds no secret. Deployed environments get
# their configuration from Doppler instead (deployment/README.md).
#
# One KEY=value per line, without quotes. Edit .env, not this file; a new key
# added here later has to be copied to .env by hand. PostgreSQL and RabbitMQ
# keep the passwords they first started with in their data: after changing one,
# run stack-down (or infra-down) before stack-up again.

# --- PostgreSQL --------------------------------------------------------------
# Database name, and the migration user that owns the schema. Only Flyway
# (the crowded-database image) connects as this user.
POSTGRES_DB=crowded
POSTGRES_USER=crowded
# Secret: password of POSTGRES_USER.
POSTGRES_PASSWORD=
# Secrets: passwords of the service users crowded_core, crowded_jobs and
# crowded_notifications, which each write only their own tables (ADR 0012).
# Letters and digits only.
CORE_DB_PASSWORD=
JOBS_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
# true loads the demo data (database/README.md#demo-accounts).
SEED_DEMO_DATA=true

# --- RabbitMQ and Redis ------------------------------------------------------
RABBITMQ_USERNAME=crowded
# Secret. Letters and digits only: it is written into a RabbitMQ config file.
RABBITMQ_PASSWORD=
# Secret.
REDIS_PASSWORD=

# --- JWT ---------------------------------------------------------------------
# Secrets: the RSA key pair Core signs tokens with (ADR 0005), each as the
# base64 of its PEM file on one line. The scripts write them back to PEM files
# in .local/jwt/ for the services.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# --- Ports on 127.0.0.1 --------------------------------------------------------
# The whole system through the router (stack-up): participant app on /,
# backoffice on /backoffice/, Core on /api/, Notifications on /api/notifications/.
HTTP_PORT=8080
# PostgreSQL, RabbitMQ and Redis, from stack-up or infra-up.
DB_PORT=5432
RABBITMQ_PORT=5672
REDIS_PORT=6379
# Apps run from source by start.
CORE_PORT=8081
JOBS_PORT=8082
NOTIFICATIONS_PORT=8083
BACKOFFICE_PORT=5173
PARTICIPANT_APP_PORT=8090

# --- Images --------------------------------------------------------------------
# Docker Hub user or organization of the images that stack-up --pull uses.
DOCKERHUB_NAMESPACE=andrereis26
